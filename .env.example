# =======================================================
# Shivaa Engineering Works - Email / SMTP Configuration
# =======================================================
#
# HOW TO SET UP GMAIL SMTP (RECOMMENDED):
# 1. Go to your Google Account settings -> Security.
# 2. Enable 2-Step Verification if not already enabled.
# 3. Search for "App Passwords" in the search bar.
# 4. Generate a new App Password for "Mail" (16 letters).
# 5. Paste the generated password in SMTP_PASS below (without spaces).
#
# NOTE: If SMTP credentials are not set, the system will log
# email payloads to the console and return a reference ID without error.

# SMTP Host (Use smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# Set to true for Port 465, false for Port 587
SMTP_SECURE=true

# Sender Email Address (e.g. shivaaengineeringworks@gmail.com)
SMTP_USER=shivaaengineeringworks@gmail.com

# Sender Email / App Password
SMTP_PASS=your-16-digit-app-password

# Recipient Email Address where inquiries should be delivered
TO_EMAIL=shivaaengineeringworks@gmail.com

# Company Name shown in email headers
COMPANY_NAME="Shivaa Engineering Works"
